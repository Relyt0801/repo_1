{
  "permissions": {
    "allow": [
      "Agent",
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "Skill(*)",
      "TaskCreate",
      "TaskList",
      "TaskGet",
      "TaskUpdate",
      "TeamCreate",
      "TeamDelete",
      "SendMessage"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
